# Copy this file to .env (same folder as docker-compose.yml) and fill it in. Never commit .env.

# Database password used by both PostgreSQL and the backend. Use a long random value.
DB_PASSWORD=

# Signs login tokens. Generate with:  openssl rand -base64 48
JWT_SECRET=

# First administrator. Only used on the very first start (empty database);
# they will be asked to choose a new password after signing in.
ADMIN_EMAIL=admin@alliancetel.com
ADMIN_PASSWORD=

# Port the website is served on. Use 80 (or put HTTPS in front, see DEPLOYMENT.md).
HTTP_PORT=80

# Time zone that decides what "today" and "this week" are.
TZ=America/Los_Angeles

# Public address of the site, for links in WhatsApp messages.
APP_URL=

# Schedule emails through Resend (resend.com). See DEPLOYMENT.md, "Email messages".
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# WhatsApp schedule messages (Meta WhatsApp Cloud API). See DEPLOYMENT.md, "WhatsApp messages".
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
